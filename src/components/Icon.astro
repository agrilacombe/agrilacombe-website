---
// Inline SVG icon from the Tabler set in @iconify-json/tabler, e.g. name="tabler:star".
// Replaces astro-icon, which does not support Astro 6+.
import tabler from '@iconify-json/tabler/icons.json';

interface Props {
  name: string;
  class?: string;
  [attr: string]: unknown;
}

const { name, class: className, ...attrs } = Astro.props;
const [set, iconName] = name.split(':');
const icon = set === 'tabler' ? tabler.icons[iconName as keyof typeof tabler.icons] : undefined;
if (!icon) throw new Error(`Unknown icon "${name}"`);
const width = (icon as { width?: number }).width ?? tabler.width ?? 24;
const height = (icon as { height?: number }).height ?? tabler.height ?? 24;
---

<svg width="1em" height="1em" viewBox={`0 0 ${width} ${height}`} class={className} data-icon={name} {...attrs} set:html={icon.body} />
